generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model IpWhitelist {
  id          Int     @id @default(autoincrement())
  ip          String  @unique
  description String?

  @@map("ip_whitelists")
}

model News {
  id         Int      @id @default(autoincrement())
  title      String
  date       String
  content    String?
  thumbnail  String?
  type       String?  @default("news")
  author_id  Int?
  metadata   Json?
  created_at DateTime @default(now())

  @@index([type, created_at], map: "news_type_created_at_idx")
  @@map("news")
}

model Users {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  role       String?  @default("admin")
  created_at DateTime @default(now())

  @@map("users")
}

model Banner {
  id  Int    @id @default(autoincrement())
  url String

  @@map("banners")
}

model Department {
  id          Int      @id @default(autoincrement())
  code        String?  @unique
  name        String
  description String?
  type        Int?     @default(1)
  parent_id   Int?
  created_at  DateTime @default(now())

  parent      Department?  @relation("DepartmentHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentHierarchy")
  employees   Employee[]
  pos_devices PosDevice[]

  @@map("departments")
}

model Employee {
  id            Int      @id @default(autoincrement())
  employee_code String   @unique
  full_name     String
  department_id Int?
  position      String?
  employee_type Int?     @default(2)
  email         String?
  phone         String?
  status        Int?     @default(1)
  created_at    DateTime @default(now())

  department         Department?        @relation(fields: [department_id], references: [id])
  device_assignments DeviceAssignment[]
  pos_assignments    PosAssignment[]
  pos_borrowings     PosBorrowing[]
  pos_paper_issues   PosPaperIssue[]

  @@map("employees")
}

model PosDevice {
  id            Int           @id @default(autoincrement())
  asset_code    String?
  serial_number String        @unique
  imei          String?
  sim_number    String?
  sim_imei      String?
  telecom_plan  String?
  enterprise    String        @default("BSH")
  department_id Int?
  region        String?
  status        String        @default("in_stock")
  notes         String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  department  Department?    @relation(fields: [department_id], references: [id])
  assignments PosAssignment[]
  borrowings  PosBorrowing[]

  @@index([status])
  @@index([enterprise])
  @@index([department_id])
  @@map("pos_devices")
}

model PosAssignment {
  id            Int       @id @default(autoincrement())
  pos_id        Int
  employee_id   Int?
  employee_name String?
  assigned_date DateTime
  returned_date DateTime?
  assigned_by   String?
  region        String?
  note          String?

  pos      PosDevice @relation(fields: [pos_id], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employee_id], references: [id])

  @@index([pos_id])
  @@index([employee_id])
  @@map("pos_assignments")
}

model PosBorrowing {
  id                   Int       @id @default(autoincrement())
  pos_id               Int
  borrower_name        String
  employee_id          Int?
  borrow_date          DateTime
  expected_return_date DateTime?
  returned_date        DateTime?
  purpose              String?
  status               String    @default("borrowing")
  note                 String?

  pos      PosDevice @relation(fields: [pos_id], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employee_id], references: [id])

  @@index([pos_id])
  @@index([employee_id])
  @@map("pos_borrowings")
}

model PosPaperInventory {
  id                Int      @id @default(autoincrement())
  paper_name        String
  code              String?  @unique
  total_quantity    Int      @default(0)
  in_stock_quantity Int      @default(0)
  issued_quantity   Int      @default(0)
  unit_price        Decimal?
  supplier_name     String?
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  issues PosPaperIssue[]

  @@map("pos_paper_inventories")
}

model PosPaperIssue {
  id            Int       @id @default(autoincrement())
  paper_id      Int
  employee_id   Int?
  employee_name String
  quantity      Int
  issue_date    DateTime
  issued_by     String?
  note          String?

  paper    PosPaperInventory @relation(fields: [paper_id], references: [id], onDelete: Cascade)
  employee Employee?          @relation(fields: [employee_id], references: [id])

  @@index([paper_id])
  @@index([employee_id])
  @@map("pos_paper_issues")
}

model DeviceCategory {
  id           Int      @id @default(autoincrement())
  code         String?  @unique
  name         String
  is_component Boolean? @default(false)
  description  String?
  parent_id    Int?

  parent       DeviceCategory?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children     DeviceCategory[] @relation("CategoryHierarchy")

  devices      Device[]

  @@map("device_categories")
}

model Supplier {
  id             Int     @id @default(autoincrement())
  name           String
  contact_person String?
  phone          String?
  email          String?
  address        String?

  devices Device[]

  @@map("suppliers")
}

model Device {
  id               Int           @id @default(autoincrement())
  asset_code       String        @unique
  name             String
  category_id      Int

  parent_device_id Int?
  brand            String?
  model            String?
  serial_number    String?       @unique
  spec_detail      String?
  manufacture_year Int?
  purchase_date    DateTime?
  purchase_price   Decimal?
  warranty_expiry  DateTime?
  supplier_id      Int?
  status           String?       @default("in_stock")
  location         String?
  notes            String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  category      DeviceCategory @relation(fields: [category_id], references: [id])

  parent_device Device?        @relation("ParentDevice", fields: [parent_device_id], references: [id])
  child_devices Device[]       @relation("ParentDevice")
  supplier      Supplier?      @relation(fields: [supplier_id], references: [id])

  assignments DeviceAssignment[]

  @@index([status])
  @@index([category_id])
  @@index([parent_device_id])
  @@map("devices")
}

model DeviceAssignment {
  id            Int       @id @default(autoincrement())
  device_id     Int
  employee_id   Int
  assigned_date DateTime
  returned_date DateTime?
  assigned_by   String?
  note          String?

  device   Device   @relation(fields: [device_id], references: [id])
  employee Employee @relation(fields: [employee_id], references: [id])

  @@index([employee_id])
  @@index([device_id])
  @@map("device_assignments")
}

model HomeShowcase {
  id Int @id
  data Json
  version Int @default(1)
  updated_at DateTime @updatedAt

  @@map("home_showcases")
}

model HomeSection {
  id         String   @id
  label      String
  order      Int      @default(0)
  visible    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("home_sections")
}

model Gallery {
  id             Int      @id @default(autoincrement())
  url            String
  original_url   String?
  title          String?
  caption        String?
  category       String?  @default("company")
  category_label String?
  date           String?
  article_id     Int?
  created_at     DateTime @default(now())

  @@index([created_at, id], map: "gallery_created_at_id_idx")
  @@index([category, created_at, id], map: "gallery_category_created_at_id_idx")
  @@map("gallery")
}

model MediaFile {
  filename  String @id
  mime_type String
  data      Bytes  @db.LongBlob
  size      Int

  @@map("media_files")
}
